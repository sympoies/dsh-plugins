{
  "name": "@sympoies/dsh-plugins-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "MIT-licensed public plugins for DeepSeek Harness",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build && npm run pack:check",
    "pack:check": "npm pack --dry-run --json --workspace @sympoies/dsh-llm-codex-subscription",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.6.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sympoies/dsh-plugins.git"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
