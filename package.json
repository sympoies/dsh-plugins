  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.6.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sympoies/dsh-plugins.git"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  }
}
